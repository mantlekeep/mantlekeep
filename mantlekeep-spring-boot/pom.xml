<?xml version="1.0" encoding="UTF-8"?>
<!--
  MantleKeep Spring Boot starter family — Maven build (equivalent to the Gradle build
  beside it; neither is a fork of the other).

  The Gradle composite and this POM express the SAME house convention, each in its
  native idiom:
    * mantlekeep-spring-boot-parent (Gradle precompiled convention plugins)
        maps to  THIS parent POM (build config every module inherits)
    * mantlekeep-spring-boot-dependencies (Gradle java-platform)
        maps to  the "-dependencies" BOM module (packaging=pom + dependencyManagement)

  So `mantlekeep-spring-boot-parent/` is a GRADLE-ONLY directory: Maven has no need of
  it — a parent POM is the mechanism itself. Nothing is missing.

  Build:  mvn -f mantlekeep-spring-boot/pom.xml install
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.mantlekeep</groupId>
  <artifactId>mantlekeep-spring-boot</artifactId>
  <version>0.1.0-rc.2</version>
  <packaging>pom</packaging>

  <name>MantleKeep Spring Boot (parent)</name>
  <description>The MantleKeep Spring Boot starter family — governed door integration, reactive and AI adapters.</description>
  <url>https://github.com/potkei/mantlekeep</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/potkei/mantlekeep</url>
    <connection>scm:git:https://github.com/potkei/mantlekeep.git</connection>
  </scm>

  <modules>
    <module>mantlekeep-spring-boot-dependencies</module>
    <module>mantlekeep-spring-boot-core</module>
    <module>mantlekeep-spring-boot-starter-webflux</module>
    <module>mantlekeep-spring-boot-starter-ai</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Java 25, mirroring the Gradle convention plugin's toolchain. -->
    <maven.compiler.release>25</maven.compiler.release>
    <spring.boot.version>4.1.0</spring.boot.version>
  </properties>

  <!-- Every module imports the family BOM, so modules declare deps WITHOUT versions
       (the Maven equivalent of Gradle's `api(platform(project(":...-dependencies")))`). -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.mantlekeep</groupId>
        <artifactId>mantlekeep-spring-boot-dependencies</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/potkei/mantlekeep</url>
    </repository>
  </distributionManagement>
</project>
