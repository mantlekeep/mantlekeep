<?xml version="1.0" encoding="UTF-8"?>
<!--
  MantleKeep Spring Boot starter family — Maven build (equivalent to the Gradle build
  beside it; neither is a fork of the other).

  The Gradle composite and this POM express the SAME house convention, each in its
  native idiom:
    * mantlekeep-spring-boot-parent (Gradle precompiled convention plugins)
        maps to  THIS parent POM (build config every module inherits)
    * mantlekeep-spring-boot-dependencies (Gradle java-platform)
        maps to  the "-dependencies" BOM module (packaging=pom + dependencyManagement)

  So `mantlekeep-spring-boot-parent/` is a GRADLE-ONLY directory: Maven has no need of
  it — a parent POM is the mechanism itself. Nothing is missing.

  Build:  mvn -f mantlekeep-spring-boot/pom.xml install
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.mantlekeep</groupId>
  <artifactId>mantlekeep-spring-boot</artifactId>
  <!-- CI-friendly version: the ONE place the family version lives (a cut bumps just this). Children
       reference it as ${revision}; flatten-maven-plugin resolves it into the deployed poms so no raw
       ${revision} ever ships. Snapshot/release override with -Drevision=X (no versions:set needed). -->
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>MantleKeep Spring Boot (parent)</name>
  <description>The MantleKeep Spring Boot starter family — governed door integration, reactive and AI adapters.</description>
  <url>https://github.com/mantlekeep/mantlekeep</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <!-- Maven Central REQUIRES <developers> on every published artifact (children inherit this).
       Missing here is why the spring-boot bundle failed Central validation while the SDK passed. -->
  <developers>
    <developer>
      <id>mantlekeep</id>
      <name>The MantleKeep Project</name>
      <url>https://github.com/mantlekeep</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/mantlekeep/mantlekeep</url>
    <connection>scm:git:https://github.com/mantlekeep/mantlekeep.git</connection>
  </scm>

  <modules>
    <!-- The family BOM (mantlekeep-spring-boot-dependencies) is NOT a Maven reactor module: nothing
         imports it now (each module imports the EXTERNAL spring-boot-dependencies directly, so consumers
         float Spring — see the dependencyManagement note below), and as pom-packaging it can't be
         ci-friendly-flattened cleanly. It remains ONLY for the Gradle build's java-platform. A consumer
         needs just the starters, whose flattened poms are self-contained. -->
    <module>mantlekeep-spring-boot-core</module>
    <module>mantlekeep-spring-boot-starter-webflux</module>
    <module>mantlekeep-spring-boot-starter-ai</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Java 25, mirroring the Gradle convention plugin's toolchain. -->
    <maven.compiler.release>25</maven.compiler.release>
    <spring.boot.version>4.1.0</spring.boot.version>
    <!-- The family version — the single source. A version cut bumps THIS (or pass -Drevision=X). -->
    <revision>0.1.1</revision>
  </properties>

  <!-- NO family-BOM import here. Two reasons:
       1. A parent cannot import its own child BOM — Maven resolves parent-level imported BOMs during
          model-building, before the reactor builds that child, so a clean Maven reactor cannot read it.
       2. CVE-float: forcing the family BOM (which bundles Spring Boot's platform) on consumers would CAP
          their Spring Boot version. Instead each module imports the EXTERNAL spring-boot-dependencies at
          BUILD time only (dependencyManagement is not transitive), leaving Spring deps version-less in the
          published pom so a consumer's own Spring Boot BOM floats them to any CVE-patched release.
       MantleKeep pins only its OWN artifacts (${revision}); it never pins Spring for consumers. -->


  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- CI-friendly versions REQUIRE flatten: a deployed pom must never contain a raw ${revision}
           (consumers can't resolve it). resolveCiFriendliesOnly substitutes ONLY revision/sha1/changelist
           and leaves everything else exactly as authored — so MantleKeep's own ${revision} deps become
           concrete while the version-less Spring deps STAY version-less (the CVE-float guarantee).
           updatePomFile=true applies it to the pom-packaging parent + BOM too, so they also ship
           resolved. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.8.0</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals><goal>flatten</goal></goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals><goal>clean</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/mantlekeep/mantlekeep</url>
    </repository>
    <!-- SNAPSHOT deploys go to the Central Portal snapshot repo (mutable), NOT GitHub Packages —
         id `central` matches the server credentials setup-java writes, so snapshot metadata
         resolves + uploads authenticate with the Central token instead of 401-ing against github. -->
    <snapshotRepository>
      <id>central</id>
      <name>Central Portal Snapshots</name>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

  <!-- The `release` profile re-routes deploy from GitHub Packages to the Sonatype Central
       the web UI, MIRRORING sdks/java so the spring-boot starters (which products + the Frame
       facade depend on) publish to Central too — not just the SDK tree. Same javadoc + gpg +
       central-publishing plumbing; sources are already attached by the base build above. -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <!-- Javadoc jar — Central REJECTS a release without one. doclint off so a lint nit
               can never break a publish, but a REAL javadoc jar is produced. (Skipped on the
               pom-packaging BOM/parent, which need none.) -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <doclint>none</doclint>
                  <quiet>true</quiet>
                  <failOnError>false</failOnError>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!-- GPG signatures on every artifact — Central requires them. Passphrase from the
               MAVEN_GPG_PASSPHRASE env var (never a literal); loopback pinentry for headless CI. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>
          <!-- The DEFAULT deploy (GitHub Packages) is skipped under release: this profile has
               ONLY Central credentials in CI, so a GitHub-Packages deploy would 401. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-deploy-plugin</artifactId>
            <configuration>
              <skip>true</skip>
            </configuration>
          </plugin>
          <!-- Uploads the signed bundle to the Central Portal (server id `central`).
               autoPublish=false → upload only; a human publishes. 0.8.0+ also routes -SNAPSHOT
               to the Central snapshot repository (mutable) for the pre-release smoke test. -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
