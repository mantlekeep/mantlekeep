<?xml version="1.0" encoding="UTF-8"?>
<!-- The BOM ("-dependencies"): pins versions for every module and imports the Spring Boot
     platform, so modules declare dependencies without versions. The Maven equivalent of
     the Gradle `java-platform`. Deliberately has NO parent — a BOM must stay standalone
     so consumers can import it without inheriting our build config. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.mantlekeep</groupId>
  <artifactId>mantlekeep-spring-boot-dependencies</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>MantleKeep Spring Boot (BOM)</name>
  <description>Version constraints for the MantleKeep Spring Boot family; imports the Spring Boot BOM.</description>

  <properties>
    <spring.boot.version>4.1.0</spring.boot.version>
  </properties>

  <!-- This BOM manages ONLY MantleKeep's own artifacts — deliberately NOT Spring Boot. A consumer who
       imports this BOM gets MANTLE's versions and brings their OWN Spring Boot BOM, so they float Spring
       to any CVE-patched release. Pinning Spring here would cap them (the very thing to avoid). Versions
       are ${revision} (the family version), resolved into the deployed pom by flatten. The two trees
       release in LOCKSTEP, so door-client (built in sdks/java) follows the same ${revision}. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.mantlekeep</groupId>
        <artifactId>mantlekeep-spring-boot-core</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>dev.mantlekeep</groupId>
        <artifactId>mantlekeep-door-client</artifactId>
        <version>${revision}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
