<?xml version="1.0" encoding="UTF-8"?>
<!-- The reactive starter: a WebClient-based DoorClient (Mono), a reactive
     @MantlekeepIntent aspect, and Spring Boot auto-configuration. Depends on -core. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.mantlekeep</groupId>
    <artifactId>mantlekeep-spring-boot</artifactId>
    <version>0.1.0-rc.4</version>
  </parent>

  <artifactId>mantlekeep-spring-boot-starter-webflux</artifactId>
  <name>MantleKeep Spring Boot starter (WebFlux)</name>
  <description>Reactive governed door integration — WebClient DoorClient + reactive @MantlekeepIntent aspect.</description>

  <dependencies>
    <dependency>
      <groupId>dev.mantlekeep</groupId>
      <artifactId>mantlekeep-spring-boot-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <dependency>
      <!-- @MantlekeepIntent aspect (Spring Boot 4 dropped starter-aop; spring-aop comes via context) -->
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
    </dependency>
    <dependency>
      <!-- Generates configuration metadata; `optional` keeps it off consumers' classpaths
           (the Maven equivalent of Gradle's annotationProcessor scope). -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
