<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared, transport-agnostic contracts: DoorClient (interface), Intent/Decision,
     @MantlekeepIntent, AgentPort. Kept minimal — only Reactor for the Mono/Flux in
     signatures. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.mantlekeep</groupId>
    <artifactId>mantlekeep-spring-boot</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>mantlekeep-spring-boot-core</artifactId>
  <name>MantleKeep Spring Boot core</name>
  <description>Transport-agnostic governance contracts shared by every MantleKeep starter.</description>

  <!-- Spring Boot's platform is imported for BUILD-time versions only; dependencyManagement is NOT
       transitive, so it does not propagate. The Spring/reactor/junit deps below stay version-less in the
       published pom, so a consumer's own Spring Boot BOM floats them (CVE-patched releases, unrestricted). -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The pure-JDK door spine — the ONE definition of Intent · Decision · DoorClient · DoorConfig.
         MantleKeep's OWN artifact, pinned lockstep to the family version (flatten resolves ${revision}). -->
    <dependency>
      <groupId>dev.mantlekeep</groupId>
      <artifactId>mantlekeep-door-client</artifactId>
      <version>${revision}</version>
    </dependency>

    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
