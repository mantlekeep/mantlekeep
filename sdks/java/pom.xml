<?xml version="1.0" encoding="UTF-8"?>
<!--
  MantleKeep Java SDK — Maven build (the alternative to the Gradle build alongside it).

  WHY BOTH: consumers were never blocked (the published artifacts are ordinary Maven
  POMs, so any Maven product can depend on them). What this adds is BUILDING the SDK
  with Maven — which matters for a Maven-shop host that must build the framework FROM
  SOURCE: air-gapped rebuilds, CVE patching on vendored source, or an internal audit of
  what it runs. Gradle stays the reference build; this is the equivalent, not a fork.

  Dependency direction (one-way, SACRED): product → starter → door-client → adapter-spi.

  Build:      mvn -f sdks/java/pom.xml install
  Publish:    mvn -f sdks/java/pom.xml deploy      (GitHub Packages; see distributionManagement)

  NOTE ON SCOPES: Gradle's `implementation` (compile classpath, not exposed to consumers)
  has no exact Maven equivalent — Maven's `compile` is transitive. Modules below use
  `compile` where the code needs it and `provided`/`test` where isolation is expressible.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.mantlekeep</groupId>
  <artifactId>mantlekeep-java-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>MantleKeep Java SDK (parent)</name>
  <description>Governance SDK for MantleKeep — the door client, adapter SPI, and Spring Boot starter.</description>
  <url>https://github.com/mantlekeep/mantlekeep</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <!-- Central REQUIRES a developer identity on every published artifact. Generic project
       identity only — no personal names/emails (this is a public, leak-clean POM). -->
  <developers>
    <developer>
      <id>mantlekeep</id>
      <name>The MantleKeep Project</name>
      <url>https://github.com/mantlekeep</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/mantlekeep/mantlekeep</url>
    <connection>scm:git:https://github.com/mantlekeep/mantlekeep.git</connection>
    <developerConnection>scm:git:https://github.com/mantlekeep/mantlekeep.git</developerConnection>
  </scm>

  <!--
    The multi-module SDK. The root flat sidecar client (dev.mantlekeep.MantlekeepClient,
    sources at sdks/java/src) is the ORIGINAL demo-path client and remains Gradle-only —
    a Maven parent cannot carry its own sources. Everything the blueprint depends on
    (starter → door-client → adapter-spi) is here.
  -->
  <modules>
    <module>mantlekeep-adapter-spi</module>
    <module>mantlekeep-door-client</module>
    <module>mantlekeep-spring-boot-starter</module>
    <module>mantlekeep-java-core</module>
    <module>mantlekeep-adapter-store-inmemory</module>
    <module>mantlekeep-adapter-policy-allowlist</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- JDK 17 bytecode by default (mirrors the Gradle `options.release = 17`);
         mantlekeep-java-core overrides to 22 for the Panama/FFM binding. -->
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>6.0.3</junit.version>
    <spring.boot.version>4.1.0</spring.boot.version>
    <spring.version>7.0.8</spring.version>
    <aspectj.version>1.9.25.1</aspectj.version>
    <assertj.version>3.27.7</assertj.version>
  </properties>

  <!-- Versions pinned ONCE here; modules declare deps without a version. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.mantlekeep</groupId>
        <artifactId>mantlekeep-adapter-spi</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.mantlekeep</groupId>
        <artifactId>mantlekeep-door-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.junit.platform</groupId>
        <artifactId>junit-platform-launcher</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-test</artifactId>
        <version>${spring.boot.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-test</artifactId>
        <version>${spring.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <!-- ApplicationContextRunner's context type implements AssertJ's AssertProvider. -->
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot</artifactId>
        <version>${spring.boot.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-autoconfigure</artifactId>
        <version>${spring.boot.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-context</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-aop</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.aspectj</groupId>
        <artifactId>aspectjweaver</artifactId>
        <version>${aspectj.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Sources jar on every module — matches the Gradle build's withSourcesJar(). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Same host + coordinates as the Gradle publish, so either build produces the
       identical GAV. Credentials come from ~/.m2/settings.xml (server id below).
       This is the DEFAULT deploy target: `mvn deploy` (no profile) publishes here,
       so a Maven-shop host keeps its GitHub Packages path. The `release` profile
       below re-routes deploy to the Central Portal instead (see its comments). -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/mantlekeep/mantlekeep</url>
    </repository>
    <!-- SNAPSHOT deploys go to the Central Portal snapshot repo (mutable), NOT GitHub Packages —
         id `central` matches the server credentials setup-java writes, so snapshot metadata
         resolves + uploads authenticate with the Central token instead of 401-ing against github. -->
    <snapshotRepository>
      <id>central</id>
      <name>Central Portal Snapshots</name>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

  <!--
    Maven Central release profile — ACTIVE ONLY under `-P release` (never in a normal
    build/deploy). It layers on the four things the Central Portal requires that a plain
    build does not: a sources jar, a javadoc jar, GPG signatures on every artifact, and
    upload to the Central Portal. Run in CI as:

        mvn -B -P release -DskipTests deploy

    Sources jar: already produced UNCONDITIONALLY by the top-level build (the
    `attach-sources` execution above, matching Gradle's withSourcesJar()), so every
    release build carries it — no source-plugin execution is repeated here (a second
    jar-no-fork binding would double-attach the same classifier and fail the deploy).

    Central is IMMUTABLE per coordinate: a released GAV can never be replaced. autoPublish
    is therefore false — CI only UPLOADS the signed bundle; a human clicks "Publish" in the
    portal after review. Never publish an -rc/-SNAPSHOT coordinate as a release.
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <!-- Javadoc jar — Central REJECTS a release without one. doclint off so a
               lint nit can never break a publish, but a REAL javadoc jar is produced. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <doclint>none</doclint>
                  <quiet>true</quiet>
                  <failOnError>false</failOnError>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- GPG signatures on every artifact — Central requires them. The passphrase is
               read non-interactively from the MAVEN_GPG_PASSPHRASE env var (never a literal);
               loopback pinentry lets it sign in a headless CI runner. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>

          <!-- The DEFAULT deploy (GitHub Packages, via distributionManagement above) is
               skipped under release: this profile has ONLY Central credentials in CI, so a
               GitHub-Packages deploy would 401. Central Portal is the sole target here. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-deploy-plugin</artifactId>
            <configuration>
              <skip>true</skip>
            </configuration>
          </plugin>

          <!-- Uploads the signed bundle to the Central Portal (server id `central` in
               ~/.m2/settings.xml). autoPublish=false → upload only; a human publishes.
               0.8.0+ ALSO publishes -SNAPSHOT builds: it auto-routes a snapshot version to the
               Central snapshot repository (mutable, no staging/publish step) — which is why the
               snapshot CI job works. 0.7.0 was release-only and silently could not deploy a snapshot. -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
